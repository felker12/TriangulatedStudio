---
import { Icon } from "astro-icon/components";

import IconButton from "@components/ui/IconButton.astro";
import LinkButton from "@components/ui/LinkButton.astro";
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";

const services = [
  {
    number: "01",
    title: "Websites",
    description:
      "Thoughtfully designed and carefully engineered websites built for growing businesses.",
    icon: "mdi:monitor-cellphone",
    href: "/services#website-packages",
  },
  {
    number: "02",
    title: "Custom Software",
    description:
      "Purpose-built applications, dashboards, internal tools, APIs, and integrations shaped around real operational needs.",
    icon: "mdi:code-braces",
    href: "/services#custom-development",
  },
  {
    number: "03",
    title: "Ongoing Support",
    description:
      "Maintenance, content updates, technical monitoring, and continued improvements after launch.",
    icon: "mdi:tools",
    href: "/services#ongoing-support",
  },
];
---

<Section
  id="services-overview"
  labelledBy="services-title"
  background="midnight"
  borderTop
  borderBottom
>
  <div class="grid gap-12 lg:grid-cols-[0.72fr_1.28fr] lg:gap-20">
    <div>
      <SectionHeader
        id="services-title"
        eyebrow="What we do"
        title="Focused services."
        muted="Built around real needs."
        mutedBlock
        description="Triangulated Studio focuses on websites, custom software, and ongoing support delivered through one connected design and development process."
        maxWidth="max-w-lg"
      />

      <LinkButton
        href="/services"
        label="Explore services"
        variant="secondary"
      />
    </div>

    <div class="border-t border-border/60">
      {
        services.map((service) => (
          <article
            class="group grid gap-5 border-b border-border/60 py-8
                   sm:grid-cols-[3rem_3.5rem_1fr_auto]
                   sm:items-start sm:gap-6"
          >
            <span class="font-mono text-xs tracking-[0.16em] text-cyan">
              {service.number}
            </span>

            <div
              class="flex h-11 w-11 items-center justify-center
                     rounded-full border border-border/60
                     text-text-muted transition-colors duration-200
                     group-hover:border-cyan/40
                     group-hover:text-cyan"
            >
              <Icon name={service.icon} size={21} />
            </div>

            <div>
              <h3
                class="font-display text-xl font-medium text-text
                       sm:text-2xl"
              >
                {service.title}
              </h3>

              <p class="mt-3 max-w-xl leading-7 text-text-muted">
                {service.description}
              </p>
            </div>

            <IconButton
              href={service.href}
              icon="mdi:arrow-top-right"
              ariaLabel={`Learn more about ${service.title}`}
            />
          </article>
        ))
      }
    </div>
  </div>
</Section>
