---
import IconButton from "@components/ui/IconButton.astro";
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";
import Tag from "@components/ui/Tag.astro";
import TextLink from "@components/ui/TextLink.astro";

import { engineeringProjects } from "@data/portfolio/engineeringProjects";
---

<Section id="engineering" labelledBy="engineering-title" background="default">
  <div
    class="mb-14 flex flex-col justify-between gap-8 sm:flex-row sm:items-end"
  >
    <SectionHeader
      id="engineering-title"
      eyebrow="Software engineering"
      title="Building products,"
      muted="not just websites."
      description="Independent software projects demonstrate the engineering practices behind the studio: secure systems, maintainable architecture, thoughtful tooling, and purposeful experimentation."
    />

    <TextLink
      href="/projects?type=engineering"
      label="Explore engineering work"
    />
  </div>

  <div class="grid border-t border-white/8 lg:grid-cols-3">
    {
      engineeringProjects.map((project, index) => (
        <article
          class:list={[
            "group flex min-h-full flex-col border-b border-white/8 py-9",
            "lg:border-b-0 lg:px-8",
            index === 0 ? "lg:pl-0" : "lg:border-l",
            index === engineeringProjects.length - 1 && "lg:pr-0",
          ]}
        >
          <div class="flex items-start justify-between gap-5">
            <div>
              <span class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-cyan">
                {String(index + 1).padStart(2, "0")} / {project.status}
              </span>

              <h3 class="mt-5 font-display text-2xl font-medium tracking-tight text-text">
                {project.title}
              </h3>
            </div>

            <IconButton
              href={project.href}
              icon="mdi:arrow-top-right"
              ariaLabel={`Explore ${project.title}`}
            />
          </div>

          <p class="mt-5 flex-1 leading-7 text-text-muted">{project.summary}</p>

          <div
            aria-label={`${project.title} technologies`}
            class="mt-8 flex flex-wrap gap-2"
          >
            {project.technologies.map((technology) => (
              <Tag label={technology} />
            ))}
          </div>

          <p class="mt-7 font-mono text-[0.65rem] uppercase tracking-[0.16em] text-text-muted">
            Independent engineering project
          </p>
        </article>
      ))
    }
  </div>
</Section>
