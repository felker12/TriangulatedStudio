---
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";

import type { ProjectChallenge } from "@data/projects/projectDetails";

interface Props {
  challenges: ProjectChallenge[];
}

const { challenges } = Astro.props;
---

<Section
  id="project-challenges"
  labelledBy="project-challenges-title"
  background="surface"
  borderTop
  borderBottom
>
  <SectionHeader
    id="project-challenges-title"
    eyebrow="Challenges"
    title="The difficult parts"
    muted="shaped the better decisions."
    description="The constraints and implementation problems that required the most thought."
    maxWidth="max-w-3xl"
  />

  <div class="mt-14 border-t border-border/60">
    {
      challenges.map((challenge, index) => (
        <article
          class="grid gap-5 border-b border-border/60 py-9
                 sm:grid-cols-[4rem_1fr] sm:gap-8"
        >
          <span class="font-mono text-xs tracking-[0.18em] text-cyan">
            {String(index + 1).padStart(2, "0")}
          </span>

          <div>
            <h3 class="font-display text-2xl font-medium tracking-tight text-text">
              {challenge.title.replace(/:$/, "")}
            </h3>

            <p class="mt-4 max-w-3xl leading-7 text-text-muted">
              {challenge.description}
            </p>
          </div>
        </article>
      ))
    }
  </div>
</Section>
