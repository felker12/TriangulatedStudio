---
import Section from "@components/ui/Section.astro";
import SectionHeader from "@components/ui/SectionHeader.astro";

import type { ProjectHighlight } from "@data/projects/projectDetails";

interface Props {
  highlights: ProjectHighlight[];
}

const { highlights } = Astro.props;
---

<Section
  id="technical-highlights"
  labelledBy="technical-highlights-title"
  background="default"
>
  <div class="grid gap-14 lg:grid-cols-[0.72fr_1.28fr] lg:gap-24">
    <SectionHeader
      id="technical-highlights-title"
      eyebrow="Technical highlights"
      title="The systems behind"
      muted="the interface."
      mutedBlock
      description="Selected architectural and implementation decisions that shaped the project."
      maxWidth="max-w-xl"
    />

    <div class="grid border-l border-t border-border/60 sm:grid-cols-2">
      {
        highlights.map((highlight, index) => (
          <article class="min-h-56 border-b border-r border-border/60 p-6 sm:p-7">
            <span class="font-mono text-xs tracking-[0.16em] text-cyan">
              {String(index + 1).padStart(2, "0")}
            </span>

            <h3 class="mt-7 font-display text-xl font-medium text-text sm:text-2xl">
              {highlight.title}
            </h3>

            <p class="mt-4 text-sm leading-6 text-text-muted">
              {highlight.description}
            </p>
          </article>
        ))
      }
    </div>
  </div>
</Section>
