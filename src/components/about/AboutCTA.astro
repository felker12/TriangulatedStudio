---
import Eyebrow from "@components/ui/Eyebrow.astro";
import LinkButton from "@components/ui/LinkButton.astro";
import Section from "@components/ui/Section.astro";
---

<Section id="about-cta" labelledBy="about-cta-title" background="default">
  <div
    class="grid gap-10 lg:grid-cols-[1fr_auto]
           lg:items-end lg:gap-20"
  >
    <div class="max-w-4xl">
      <Eyebrow text="Start a conversation" />

      <h2
        id="about-cta-title"
        class="font-display text-4xl font-medium
               tracking-[-0.04em] text-text
               sm:text-5xl lg:text-6xl"
      >
        Have a project that needs
        <span class="text-text-muted"> a thoughtful approach? </span>
      </h2>

      <p class="mt-6 max-w-2xl text-lg leading-8 text-text-muted">
        Share what you are building, where the project currently stands, and
        what a successful result would look like.
      </p>
    </div>

    <LinkButton
      href="/contact"
      label="Start a project"
      variant="primary"
      marginTop={false}
    />
  </div>
</Section>
