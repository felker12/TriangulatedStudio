---
const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY;

const projectTypes = [
  "Website design & development",
  "Custom software development",
  "Brand identity",
  "Website support",
  "Not sure yet",
];

const budgetRanges = [
  "Under $2,500",
  "$2,500 - $5,000",
  "$5,000 - $10,000",
  "$10,000+",
  "Not sure yet",
];

const inputClasses = `
  w-full rounded-lg border border-white/10
  bg-surface/70 px-4 py-3.5
  text-sm text-text placeholder:text-text-muted/50
  shadow-[inset_0_1px_0_rgba(255,255,255,0.025)]
  outline-none backdrop-blur-sm
  transition-[border-color,box-shadow,background-color] duration-200
  hover:border-white/20
  focus:border-cyan/50
  focus:bg-surface-light/60
  focus:ring-4 focus:ring-cyan/8
`;
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="contact-form"
  class="needs-validation space-y-6"
  novalidate
>
  <input type="hidden" name="access_key" value={web3formsKey} />
  <input
    type="hidden"
    name="subject"
    value="New Triangulated Studio project inquiry"
  />
  <input type="hidden" name="from_name" value="Triangulated Studio Website" />

  <input
    type="checkbox"
    name="botcheck"
    class="hidden"
    style="display:none"
    tabindex="-1"
    autocomplete="off"
  />

  <div class="grid gap-6 sm:grid-cols-2">
    <!-- Full name -->
    <div class="space-y-2">
      <label
        for="name"
        class="block font-mono text-[0.66rem] uppercase
               tracking-[0.14em] text-cyan"
      >
        Full name
      </label>

      <input
        id="name"
        type="text"
        name="name"
        autocomplete="name"
        placeholder="John Doe"
        required
        class={inputClasses}
      />

      <p
        class="empty-feedback invalid-feedback hidden pl-1
               font-mono text-xs text-red-300"
      >
        Please provide your full name.
      </p>
    </div>

    <!-- Email -->
    <div class="space-y-2">
      <label
        for="email-address"
        class="block font-mono text-[0.66rem] uppercase
               tracking-[0.14em] text-cyan"
      >
        Email address
      </label>

      <input
        id="email-address"
        type="email"
        name="email"
        autocomplete="email"
        placeholder="you@example.com"
        required
        class={inputClasses}
      />

      <p
        class="empty-feedback hidden pl-1
               font-mono text-xs text-red-300"
      >
        Please provide your email address.
      </p>

      <p
        class="invalid-feedback hidden pl-1
               font-mono text-xs text-red-300"
      >
        Please provide a valid email address.
      </p>
    </div>
  </div>

  <!-- Business -->
  <div class="space-y-2">
    <label
      for="business"
      class="block font-mono text-[0.66rem] uppercase
             tracking-[0.14em] text-cyan"
    >
      Business or organization
      <span class="text-text-muted">{" "} — optional</span>
    </label>

    <input
      id="business"
      type="text"
      name="business"
      autocomplete="organization"
      placeholder="Your business name"
      class={inputClasses}
    />
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <!-- Project type -->
    <div class="space-y-2">
      <label
        for="project-type"
        class="block font-mono text-[0.66rem] uppercase
               tracking-[0.14em] text-cyan"
      >
        Project type
      </label>

      <div class="relative">
        <select
          id="project-type"
          name="project_type"
          required
          class={`${inputClasses} appearance-none pr-11`}
        >
          <option value="" selected disabled>Select a service</option>

          {projectTypes.map((type) => <option value={type}>{type}</option>)}
        </select>

        <span
          aria-hidden="true"
          class="pointer-events-none absolute right-4 top-1/2
                 -translate-y-1/2 text-cyan"
        >
          ▾
        </span>
      </div>

      <p
        class="invalid-feedback hidden pl-1
               font-mono text-xs text-red-300"
      >
        Please select a project type.
      </p>
    </div>

    <!-- Budget -->
    <div class="space-y-2">
      <label
        for="budget"
        class="block font-mono text-[0.66rem] uppercase
               tracking-[0.14em] text-cyan"
      >
        Estimated budget
        <span class="text-text-muted">{" "} — optional</span>
      </label>

      <div class="relative">
        <select
          id="budget"
          name="budget"
          class={`${inputClasses} appearance-none pr-11`}
        >
          <option value="" selected>Select a range</option>

          {budgetRanges.map((range) => <option value={range}>{range}</option>)}
        </select>

        <span
          aria-hidden="true"
          class="pointer-events-none absolute right-4 top-1/2
                 -translate-y-1/2 text-cyan"
        >
          ▾
        </span>
      </div>
    </div>
  </div>

  <!-- Timeline -->
  <div class="space-y-2">
    <label
      for="timeline"
      class="block font-mono text-[0.66rem] uppercase
             tracking-[0.14em] text-cyan"
    >
      Ideal timeline
      <span class="text-text-muted">{" "} — optional</span>
    </label>

    <input
      id="timeline"
      type="text"
      name="timeline"
      placeholder="For example: within 2 - 3 months"
      class={inputClasses}
    />
  </div>

  <!-- Message -->
  <div class="space-y-2">
    <label
      for="message"
      class="block font-mono text-[0.66rem] uppercase
             tracking-[0.14em] text-cyan"
    >
      Tell us about the project
    </label>

    <textarea
      id="message"
      name="message"
      required
      rows="7"
      placeholder="What are you building, what problem should it solve, and what would a successful outcome look like?"
      class={`${inputClasses} min-h-48 resize-y leading-relaxed`}></textarea>

    <p
      class="empty-feedback invalid-feedback hidden pl-1
             font-mono text-xs text-red-300"
    >
      Please tell us a little about your project.
    </p>
  </div>

  <div class="flex flex-col gap-4 pt-2 sm:flex-row sm:items-center">
    <button
      type="submit"
      class="group relative inline-flex min-h-12 w-full
             items-center justify-center gap-3 overflow-hidden
             rounded-full border border-cyan/40
             bg-cyan/8 px-6
             text-sm font-semibold text-text
             shadow-[0_0_28px_rgba(85,210,247,0.10)]
             transition-all duration-300
             before:absolute before:inset-0
             before:-translate-x-full
             before:bg-linear-to-r before:from-transparent
             before:via-white/8 before:to-transparent
             before:transition-transform before:duration-500
             before:content-['']
             hover:-translate-y-0.5
             hover:border-cyan
             hover:bg-cyan/15
             hover:shadow-[0_0_34px_rgba(85,210,247,0.18)]
             hover:before:translate-x-full
             focus-visible:outline-none
             focus-visible:ring-2
             focus-visible:ring-cyan
             focus-visible:ring-offset-2
             focus-visible:ring-offset-void
             disabled:cursor-not-allowed
             disabled:opacity-60
             disabled:hover:translate-y-0
             sm:w-auto"
    >
      <span class="relative z-1">Send project inquiry</span>
    </button>

    <p
      id="form-result"
      class="min-h-6 flex-1 font-mono text-xs"
      role="status"
      aria-live="polite"
    >
    </p>
  </div>
</form>

<style>
  .invalid-feedback,
  .empty-feedback {
    display: none;
  }

  .was-validated :placeholder-shown:invalid ~ .empty-feedback {
    display: block;
  }

  .was-validated :not(:placeholder-shown):invalid ~ .invalid-feedback {
    display: block;
  }

  .was-validated select:invalid ~ .invalid-feedback {
    display: block;
  }

  .was-validated :invalid {
    border-color: rgb(252 165 165 / 0.75);
    box-shadow:
      0 0 0 4px rgb(239 68 68 / 0.08),
      inset 0 1px 0 rgb(255 255 255 / 0.03);
  }
</style>

<script is:inline>
  const form = document.getElementById("contact-form");
  const result = document.getElementById("form-result");

  if (form instanceof HTMLFormElement && result instanceof HTMLElement) {
    const submitButton = form.querySelector('button[type="submit"]');

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      form.classList.add("was-validated");

      if (!form.checkValidity()) {
        const invalidField = form.querySelector(":invalid");

        if (invalidField instanceof HTMLElement) {
          invalidField.focus();
        }

        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      result.className = "min-h-6 flex-1 font-mono text-xs text-text-muted";
      result.textContent = "Sending your inquiry...";

      try {
        const formData = new FormData(form);
        const payload = Object.fromEntries(formData.entries());

        if (!payload.botcheck) {
          payload.botcheck = "";
        }

        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.message || "Unable to send your inquiry.");
        }

        result.className = "min-h-6 flex-1 font-mono text-xs text-emerald-300";
        result.textContent = "Thank you. Your inquiry was sent successfully.";

        form.reset();
        form.classList.remove("was-validated");
      } catch (error) {
        console.error(error);

        result.className = "min-h-6 flex-1 font-mono text-xs text-red-300";

        result.textContent =
          error instanceof Error
            ? error.message
            : "Something went wrong. Please try again.";
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }

        window.setTimeout(() => {
          result.textContent = "";
        }, 7000);
      }
    });
  }
</script>
