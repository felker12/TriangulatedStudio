---
// src/components/nav/NavItem.astro
import { type NavGroup } from "@data/nav";
import { Icon } from "astro-icon/components";

interface Props {
  href: string;
  label: string;
  ariaLabel: string;
  children?: NavGroup[];
  isActive: boolean;
}

const { href, label, ariaLabel, isActive, children } = Astro.props;

const hasChildren = (children?.length ?? 0) > 0;
---

<a
  href={href}
  aria-label={ariaLabel}
  aria-current={isActive ? "page" : undefined}
  class:list={[
    `relative inline-flex items-center gap-1
     rounded-sm text-sm font-medium tracking-wide
     no-underline transition-colors duration-150

     after:absolute after:inset-x-0 after:-bottom-1.5 after:h-px
     after:origin-left
     after:transition-transform after:duration-150

     focus-visible:outline-none
     focus-visible:ring-2
     focus-visible:ring-blue-soft
     focus-visible:ring-offset-4
     focus-visible:ring-offset-void`,

    isActive
      ? `text-electric after:scale-x-100`
      : `text-text-muted after:scale-x-0
         hover:text-blue-soft hover:after:scale-x-100`,
  ]}
>
  {label}

  {
    hasChildren && (
      <Icon
        name="mdi:chevron-down"
        size={16}
        color="currentColor"
        class="hidden transition-transform duration-200
               group-hover:rotate-180
               group-focus-within:rotate-180
               md:block"
      />
    )
  }
</a>
