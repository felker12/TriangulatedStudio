---
import { type NavGroup } from "@data/nav";

interface Props {
  pathname: string;
  projectGroups: NavGroup[];
}

const { pathname, projectGroups } = Astro.props;
---

<!-- Desktop dropdown -->
<ul
  class="pointer-events-none invisible absolute left-0 top-full hidden min-w-72
    translate-y-2 pt-3 opacity-0
    transition-all duration-200 ease-out
    group-hover:pointer-events-auto
    group-hover:visible
    group-hover:translate-y-0
    group-hover:opacity-100
    group-focus-within:pointer-events-auto
    group-focus-within:visible
    group-focus-within:translate-y-0
    group-focus-within:opacity-100
    md:block"
>
  <li
    class="relative overflow-hidden
      border border-border/60
      bg-midnight/95
      shadow-[0_18px_50px_rgba(0,0,0,0.45)]
      backdrop-blur-xl
      before:absolute before:inset-x-0 before:top-0 before:h-px
      before:bg-linear-to-r
      before:from-transparent
      before:via-cyan/35
      before:to-transparent"
    style="clip-path: polygon(
      0 0,
      calc(100% - 22px) 0,
      100% 22px,
      100% 100%,
      0 100%
    );"
  >
    <div class="border-b border-border/60 px-4 py-3">
      <p
        class="font-mono text-[0.62rem] uppercase tracking-[0.18em]
          text-text-muted"
      >
        Selected Work
      </p>
    </div>

    <div class="p-2">
      {
        projectGroups.map((group, groupIndex) => (
          <div
            class:list={[
              groupIndex > 0 && "mt-2 border-t border-border/60 pt-2",
            ]}
          >
            <p
              class="px-3 pb-1.5 pt-2 font-mono text-[0.6rem]
                uppercase tracking-[0.18em] text-cyan/75"
            >
              {group.label}
            </p>

            <ul>
              {group.links.map((project) => {
                const projectActive = pathname.startsWith(project.href);

                return (
                  <li>
                    <a
                      href={project.href}
                      aria-label={project.ariaLabel}
                      aria-current={projectActive ? "page" : undefined}
                      class:list={[
                        `group/project relative flex items-center
                           justify-between gap-4 rounded-lg px-3 py-2.5
                           text-sm no-underline
                           transition-[background,color,transform,box-shadow]
                           duration-200

                           before:absolute before:left-0 before:top-1/2
                           before:h-6 before:w-px
                           before:-translate-y-1/2
                           before:bg-electric
                           before:shadow-[0_0_10px_rgba(23,139,220,0.85)]
                           before:transition-opacity before:duration-200

                           focus-visible:outline-none
                           focus-visible:ring-2
                           focus-visible:ring-cyan/70`,

                        projectActive
                          ? `bg-electric/10 text-blue-soft
                               shadow-[inset_0_0_18px_rgba(23,139,220,0.05)]
                               before:opacity-100`
                          : `text-text-muted before:opacity-0
                               hover:translate-x-0.5
                               hover:bg-white/4
                               hover:text-text
                               hover:before:opacity-100`,
                      ]}
                    >
                      <span>{project.label}</span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="border-t border-border/60 px-4 py-3">
      <a
        href="/projects"
        class="text-xs font-medium tracking-wide text-text-muted
          transition-colors duration-200 hover:text-cyan"
      >
        View all projects →
      </a>
    </div>
  </li>
</ul>

<!-- Mobile project groups -->
<div class="ml-4 mt-2 border-l border-border/50 pl-4 md:hidden">
  {
    projectGroups.map((group, groupIndex) => (
      <div class:list={[groupIndex > 0 && "mt-4"]}>
        <p
          class="mb-1 px-3 font-mono text-[0.6rem] uppercase
            tracking-[0.18em] text-cyan/75"
        >
          {group.label}
        </p>

        <ul class="space-y-1">
          {group.links.map((project) => {
            const projectActive = pathname.startsWith(project.href);

            return (
              <li>
                <a
                  href={project.href}
                  aria-label={project.ariaLabel}
                  aria-current={projectActive ? "page" : undefined}
                  class:list={[
                    `relative block rounded-md px-3 py-2
                       font-mono text-xs tracking-wide no-underline
                       transition-colors duration-200

                       before:absolute before:left-[-1.05rem]
                       before:top-1/2 before:h-1.5 before:w-1.5
                       before:-translate-y-1/2 before:rounded-full
                       before:bg-electric
                       before:shadow-[0_0_8px_rgba(23,139,220,0.8)]
                       before:transition-opacity before:duration-200

                       focus-visible:outline-none
                       focus-visible:ring-2
                       focus-visible:ring-cyan
                       focus-visible:ring-offset-2
                       focus-visible:ring-offset-void`,

                    projectActive
                      ? `bg-electric/10 font-semibold text-blue-soft
                           before:opacity-100`
                      : `text-text-muted before:opacity-0
                           hover:bg-white/4
                           hover:text-text
                           hover:before:opacity-100`,
                  ]}
                >
                  {project.label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }

  <a
    href="/projects"
    class="mt-4 inline-flex px-3 py-2 text-xs font-medium
      tracking-wide text-text-muted transition-colors duration-200
      hover:text-cyan"
  >
    View all projects
  </a>
</div>
