---
// src/components/nav/Header.astro
import { Image } from "astro:assets";
import logoImage from "@assets/Logo_NoBackground.png";
import NavBar from "@components/nav/NavBar.astro";
---

<header
  class="relative z-40 border-b border-white/8
         bg-void/75 px-5 backdrop-blur-xl text-text-muted"
>
  <div class="mx-auto flex min-h-20 max-w-7xl items-center justify-between">
    <a
      href="/"
      aria-label="Triangulated Studio home"
      class="group flex items-center gap-3"
    >
      <Image
        src={logoImage}
        alt=""
        width={60}
        height={60}
        densities={[1.5, 2]}
        loading="eager"
        format="webp"
        quality={90}
        class="object-contain transition-transform duration-300
           group-hover:scale-105"
      />

      <span
        class="hidden text-sm font-medium uppercase tracking-[0.16em]
           text-text sm:block"
      >
        Triangulated
        <span class="text-electric">Studio</span>
      </span>
    </a>

    <NavBar />
  </div>
</header>
