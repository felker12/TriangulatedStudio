---
//src/pages/contact.astro
import Layout from "@layouts/Layout.astro";
import Section from "@components/ui/Section.astro";
import Eyebrow from "@components/ui/Eyebrow.astro";
import ContactForm from "@components/contact/ContactForm.astro";
---

<Layout
  title="Start a Project"
  description="Contact Triangulated Studio to discuss a website, custom software project, brand identity, digital design, or ongoing website support."
>
  <Section
    id="contact"
    labelledBy="contact-title"
    background="default"
    class="relative overflow-hidden"
  >
    <div
      class="grid gap-16 lg:grid-cols-[0.78fr_1.22fr]
             lg:items-start lg:gap-24"
    >
      <div class="lg:sticky lg:top-10">
        <Eyebrow text="Start a conversation" />

        <h1
          id="contact-title"
          class="max-w-2xl font-display text-5xl font-medium
                 leading-[0.98] tracking-[-0.045em] text-text
                 sm:text-6xl lg:text-7xl"
        >
          Let's connect{" "}
          <span class="text-text-muted">the first point.</span>
        </h1>

        <p class="mt-7 max-w-lg text-lg leading-8 text-text-muted">
          Share what you are building, where the project currently stands, and
          what a successful outcome would look like.
        </p>

        <div class="mt-12 border-t border-border/60 pt-8">
          <p
            class="font-mono text-[0.66rem] uppercase
                   tracking-[0.18em] text-cyan"
          >
            What happens next
          </p>

          <ol class="mt-6 space-y-6">
            <li class="grid grid-cols-[2rem_1fr] gap-4">
              <span class="font-mono text-xs text-cyan">01</span>

              <div>
                <h2 class="font-display text-lg font-medium text-text">
                  We review your inquiry
                </h2>

                <p class="mt-2 text-sm leading-6 text-text-muted">
                  We'll look over your goals, scope, timeline, and any existing
                  materials.
                </p>
              </div>
            </li>

            <li class="grid grid-cols-[2rem_1fr] gap-4">
              <span class="font-mono text-xs text-cyan">02</span>

              <div>
                <h2 class="font-display text-lg font-medium text-text">
                  We schedule a conversation
                </h2>

                <p class="mt-2 text-sm leading-6 text-text-muted">
                  If the project looks like a good fit, we'll arrange a short
                  discovery conversation.
                </p>
              </div>
            </li>

            <li class="grid grid-cols-[2rem_1fr] gap-4">
              <span class="font-mono text-xs text-cyan">03</span>

              <div>
                <h2 class="font-display text-lg font-medium text-text">
                  We define the next steps
                </h2>

                <p class="mt-2 text-sm leading-6 text-text-muted">
                  From there, we can clarify the scope, approach, estimated
                  investment, and timeline.
                </p>
              </div>
            </li>
          </ol>
        </div>
      </div>

      <div
        class="relative border border-border/60 bg-white/2
               p-6 sm:p-8 lg:p-10"
        style="clip-path: polygon(
          0 0,
          calc(100% - 28px) 0,
          100% 28px,
          100% 100%,
          28px 100%,
          0 calc(100% - 28px)
        );"
      >
        <div class="mb-8 border-b border-white/8 pb-7">
          <p
            class="font-mono text-xs uppercase
                   tracking-[0.18em] text-cyan"
          >
            Project inquiry
          </p>

          <h2
            class="mt-3 font-display text-2xl font-medium
                   tracking-tight text-text sm:text-3xl"
          >
            Tell us what you have in mind.
          </h2>

          <p class="mt-3 max-w-xl text-sm leading-6 text-text-muted">
            Fields marked as required help us understand whether the project is
            a good fit. Estimates are completely fine.
          </p>
        </div>

        <ContactForm />
      </div>
    </div>

    <div
      aria-hidden="true"
      class="absolute -bottom-24 -left-24 -z-10
             h-64 w-64 rotate-45 border border-cyan/5"
    >
    </div>
  </Section>
</Layout>
